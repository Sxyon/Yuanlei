{
  "notice": "全部为合成设计样例，无产品连接或发布",
  "rule_version": 1,
  "materials": [
    "metric@1",
    "result-list@1",
    "trend-chart@1",
    "analysis-note@1",
    "data-table@1",
    "flow-lanes@1"
  ],
  "templates": [
    {
      "id": "delivery-watch",
      "version": 1,
      "scope": "builtin",
      "name": "交付观察",
      "definition": {
        "schema_version": 1,
        "title": "交付观察",
        "inputs": [
          {
            "id": "results",
            "contract": "work.results.v1",
            "required_fields": [
              "task_id",
              "result_id",
              "title",
              "summary",
              "criteria_revision",
              "status"
            ],
            "filters": {
              "status": "pending"
            },
            "required": true
          }
        ],
        "layout": {
          "kind": "grid",
          "columns": 12,
          "children": [
            {
              "id": "summary",
              "component": "metric@1",
              "input": "results",
              "mapping": {
                "value": "totals.total_results"
              },
              "span": 4,
              "mobile_span": 12,
              "display": {
                "label": "待验收份数",
                "format": "integer"
              }
            },
            {
              "id": "list",
              "component": "result-list@1",
              "input": "results",
              "mapping": {
                "title": "title",
                "summary": "summary",
                "status": "status"
              },
              "span": 8,
              "mobile_span": 12,
              "action": {
                "type": "open-result",
                "ids": {
                  "task": "task_id",
                  "result": "result_id"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": "business-watch",
      "version": 1,
      "scope": "builtin",
      "name": "经营观察",
      "definition": {
        "schema_version": 1,
        "title": "经营观察",
        "inputs": [
          {
            "id": "trend",
            "contract": "business.monthly.v1",
            "required_fields": [
              "month",
              "amount"
            ],
            "required": true
          },
          {
            "id": "regions",
            "contract": "business.regions.v1",
            "required_fields": [
              "region",
              "amount",
              "missing_count"
            ],
            "required": true
          },
          {
            "id": "analysis",
            "contract": "analysis.note.v1",
            "required_fields": [
              "content",
              "author",
              "as_of",
              "basis"
            ],
            "required": true
          }
        ],
        "layout": {
          "kind": "grid",
          "columns": 12,
          "children": [
            {
              "id": "trend",
              "component": "trend-chart@1",
              "input": "trend",
              "mapping": {
                "x": "month",
                "y": "amount"
              },
              "span": 8,
              "mobile_span": 12,
              "display": {
                "unit": "CNY",
                "format": "currency"
              }
            },
            {
              "id": "analysis",
              "component": "analysis-note@1",
              "input": "analysis",
              "mapping": {
                "text": "content",
                "author": "author",
                "time": "as_of",
                "basis": "basis"
              },
              "span": 4,
              "mobile_span": 12
            },
            {
              "id": "regions",
              "component": "data-table@1",
              "input": "regions",
              "mapping": {
                "columns": [
                  "region",
                  "amount",
                  "missing_count"
                ]
              },
              "span": 12,
              "mobile_span": 12,
              "display": {
                "unit": "CNY",
                "format": "currency"
              }
            }
          ]
        }
      }
    }
  ],
  "instances": [
    {
      "id": "alpha-delivery",
      "project": "alpha",
      "name": "交付观察",
      "template_ref": {
        "id": "delivery-watch",
        "version": 1
      },
      "bindings": {
        "results": {
          "source": "project.work_results",
          "parameters": {
            "status": "pending"
          }
        }
      }
    },
    {
      "id": "beta-delivery",
      "project": "beta",

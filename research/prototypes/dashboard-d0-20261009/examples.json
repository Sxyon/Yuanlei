        "revision": 7
      },
      "regions": {
        "source": "project.dataset",
        "dataset_id": "dataset-beta-regions",
        "revision": 4
      },
      "analysis": {
        "source": "project.dataset",
        "dataset_id": "dataset-beta-analysis",
        "revision": 1,
        "kind": "analysis"
      }
    }
  },
  "autonomous": {
    "instance": {
      "id": "alpha-flow",
      "project": "alpha",
      "template_ref": null
    },
    "definition": {
      "schema_version": 1,
      "title": "执行路径观察",
      "inputs": [
        {
          "id": "work",
          "contract": "work.summary.v1",
          "required_fields": [
            "task_id",
            "title",
            "status"
          ],
          "required": true
        },
        {
          "id": "results",
          "contract": "work.results.v1",
          "required_fields": [
            "task_id",
            "result_id",
            "title",
            "summary"
          ],
          "required": true
        },
        {
          "id": "analysis",
          "contract": "analysis.note.v1",
          "required_fields": [
            "content",
            "author",
            "as_of",
            "basis"
          ],
          "required": true
        }
      ],
      "layout": {
        "kind": "stack",
        "children": [
          {
            "id": "context",
            "component": "analysis-note@1",
            "input": "analysis",
            "mapping": {
              "text": "content",
              "author": "author",
              "time": "as_of",
              "basis": "basis"
            },
            "span": 12,
            "mobile_span": 12
          },
          {
            "id": "lanes",
            "component": "flow-lanes@1",
            "input": "work",
            "mapping": {
              "group": "status",
              "label": "title"
            },
            "span": 12,
            "mobile_span": 12,
            "action": {
              "type": "open-work",
              "ids": {
                "task": "task_id"
              }
            }
          },
          {
            "id": "results",
            "component": "result-list@1",
            "input": "results",
            "mapping": {
              "title": "title",
              "summary": "summary"
            },
            "span": 12,
            "mobile_span": 12,
            "action": {
              "type": "open-result",
              "ids": {
                "task": "task_id",
                "result": "result_id"
              }
            }
          }
        ]
      }
    },
    "bindings": {
      "work": {
        "source": "project.work_summary"
      },
      "results": {
        "source": "project.work_results"
      },
      "analysis": {
        "source": "project.dataset",
        "dataset_id": "dataset-alpha-analysis",
        "revision": 1,
        "kind": "analysis"
      }
    }
  },

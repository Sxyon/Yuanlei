        "revision": 3
      },
      "regions": {
        "source": "project.dataset",
        "dataset_id": "dataset-alpha-regions",
        "revision": 2
      },
      "analysis": {
        "source": "project.dataset",
        "dataset_id": "dataset-alpha-analysis",

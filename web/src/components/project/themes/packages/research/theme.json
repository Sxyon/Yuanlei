{
  "id": "research",
  "version": "1.0.0",
  "name": "调研 · 依据阅读",
  "topicLabel": "课题",
  "pages": [
    {
      "id": "context",
      "title": "课题脉络",
      "description": "从研究问题开始，沿讨论、证据和决定理解当前判断。",
      "layout": "reading",
      "blocks": [
        {
          "id": "selector",
          "type": "records",
          "title": "课题目录",
          "region": "aside",
          "binding": {
            "kind": "business",
            "resource": "topics",
            "scope": "project"
          },
          "variant": "selector"
        },
        {
          "id": "question",
          "type": "topic",
          "title": "研究问题",
          "region": "main",
          "binding": {
            "kind": "business",
            "resource": "selectedTopic"
          }
        },
        {
          "id": "discussion",
          "type": "discussion",
          "title": "讨论脉络",
          "region": "main",
          "binding": {
            "kind": "business",
            "resource": "discussions"
          }
        },
        {
          "id": "judgment",
          "type": "records",
          "title": "证据与判断",
          "region": "main",
          "binding": {
            "kind": "business",
            "resource": "decisions",
            "scope": "selectedTopic"
          },
          "variant": "list",
          "statuses": [
            "approved"
          ],
          "action": {
            "kind": "page",
            "pageId": "evidence"
          }
        }
      ]
    },
    {
      "id": "evidence",
      "title": "证据资料",
      "description": "按当前课题阅读指定资料；资料本身不代表批准。",
      "layout": "reading",
      "blocks": [
        {
          "id": "selector",
          "type": "records",
          "title": "资料索引",
          "region": "aside",
          "binding": {
            "kind": "business",
            "resource": "topics",
            "scope": "project"
          },
          "variant": "compactSelector"
        },
        {
          "id": "survey",
          "type": "json",
          "title": "访谈汇总 · 指定项目文件",
          "region": "main",
          "binding": {
            "kind": "file",
            "alias": "survey"
          }
        },
        {
          "id": "distribution",
          "type": "image",
          "title": "独立访谈示例 · 固定包内图像",
          "region": "main",
          "binding": {
            "kind": "asset",
            "alias": "distribution"
          },
          "alt": "固定合成示例，不随项目变化；24份访谈：15份愿意试点、6份仍需评估、3份暂不参与"
        },
        {
          "id": "context",
          "type": "topic",
          "title": "阅读上下文",
          "region": "main",
          "binding": {
            "kind": "business",
            "resource": "selectedTopic"
          }
        }
      ]
    },
    {
      "id": "conclusions",
      "title": "研究结论",
      "description": "区分正式决定、历史依据与后续验证任务。",
      "layout": "overview",
      "blocks": [
        {
          "id": "conclusions",
          "type": "records",
          "title": "正式结论",
          "region": "main",
          "binding": {
            "kind": "business",
            "resource": "decisions",
            "scope": "project"
          },
          "variant": "conclusions",
          "statuses": [
            "approved"
          ]
        },
        {
          "id": "history",
          "type": "records",
          "title": "历史依据",
          "region": "main",
          "binding": {
            "kind": "business",
            "resource": "decisions",
            "scope": "project"
          },
          "variant": "history",
          "statuses": [
            "superseded",
            "revoked"
          ]
        },
        {
          "id": "work",
          "type": "records",
          "title": "后续验证任务",
          "region": "aside",
          "binding": {
            "kind": "business",
            "resource": "workTasks",
            "scope": "project"
          },
          "variant": "list"
        }
      ]
    }
  ]
}

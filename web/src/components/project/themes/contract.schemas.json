{
  "package": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "Asset": {
        "additionalProperties": false,
        "description": "包内资源声明，不携项目文件路径。",
        "properties": {
          "path": {
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "mediaType": {
            "enum": [
              "application/json",
              "image/png"
            ],
            "title": "Mediatype",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "path",
          "mediaType",
          "sha256"
        ],
        "title": "Asset",
        "type": "object"
      },
      "DiscussionBinding": {
        "additionalProperties": false,
        "description": "选定议题的讨论，不定义全局讨论集合。",
        "properties": {
          "kind": {
            "const": "business",
            "title": "Kind",
            "type": "string"
          },
          "resource": {
            "const": "discussions",
            "title": "Resource",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "resource"
        ],
        "title": "DiscussionBinding",
        "type": "object"
      },
      "DiscussionBlock": {
        "additionalProperties": false,
        "description": "选定议题的只读讨论。",
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "region": {
            "enum": [
              "summary",
              "main",
              "aside"
            ],
            "title": "Region",
            "type": "string"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/$defs/PageEvent"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "type": {
            "const": "discussion",
            "title": "Type",
            "type": "string"
          },
          "binding": {
            "$ref": "#/$defs/DiscussionBinding"
          }
        },
        "required": [
          "id",
          "title",
          "region",
          "type",
          "binding"
        ],
        "title": "DiscussionBlock",
        "type": "object"
      },
      "ImageBlock": {
        "additionalProperties": false,
        "description": "PNG资料和必要的等价描述。",
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "region": {
            "enum": [
              "summary",
              "main",
              "aside"
            ],
            "title": "Region",
            "type": "string"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/$defs/PageEvent"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "type": {
            "const": "image",
            "title": "Type",
            "type": "string"
          },
          "binding": {
            "$ref": "#/$defs/ResourceBinding"
          },
          "alt": {
            "minLength": 1,
            "title": "Alt",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "region",
          "type",
          "binding",
          "alt"
        ],
        "title": "ImageBlock",
        "type": "object"
      },
      "JsonBlock": {
        "additionalProperties": false,
        "description": "资料JSON，与主题定义分开消费。",
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "region": {
            "enum": [
              "summary",
              "main",
              "aside"
            ],
            "title": "Region",
            "type": "string"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/$defs/PageEvent"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "type": {
            "const": "json",
            "title": "Type",
            "type": "string"
          },
          "binding": {
            "$ref": "#/$defs/ResourceBinding"
          }
        },
        "required": [
          "id",
          "title",
          "region",
          "type",
          "binding"
        ],
        "title": "JsonBlock",
        "type": "object"
      },
      "Manifest": {
        "additionalProperties": false,
        "description": "可携主题包清单，身份和绑定由宿主另行提供。",
        "properties": {
          "formatVersion": {
            "maximum": 1,
            "minimum": 1,
            "title": "Formatversion",
            "type": "integer"
          },
          "componentAbi": {
            "maximum": 1,
            "minimum": 1,
            "title": "Componentabi",
            "type": "integer"
          },
          "theme": {
            "const": "theme.json",
            "title": "Theme",
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "files": {
            "additionalProperties": {
              "enum": [
                "application/json",
                "image/png"
              ],
              "type": "string"
            },
            "propertyNames": {
              "minLength": 1
            },
            "title": "Files",
            "type": "object"
          },
          "assets": {
            "additionalProperties": {
              "$ref": "#/$defs/Asset"
            },
            "propertyNames": {
              "minLength": 1
            },
            "title": "Assets",
            "type": "object"
          }
        },
        "required": [
          "formatVersion",
          "componentAbi",
          "theme",
          "source",
          "files",
          "assets"
        ],
        "title": "Manifest",
        "type": "object"
      },
      "Page": {
        "additionalProperties": false,
        "description": "有限页面布局，不携CSS或组件代码。",
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "layout": {
            "enum": [
              "overview",
              "reading",
              "full"
            ],
            "title": "Layout",
            "type": "string"
          },
          "blocks": {
            "items": {
              "discriminator": {
                "mapping": {
                  "discussion": "#/$defs/DiscussionBlock",
                  "image": "#/$defs/ImageBlock",
                  "json": "#/$defs/JsonBlock",
                  "records": "#/$defs/RecordsBlock",
                  "summary": "#/$defs/SummaryBlock",
                  "topic": "#/$defs/TopicBlock"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/SummaryBlock"
                },
                {
                  "$ref": "#/$defs/RecordsBlock"
                },
                {
                  "$ref": "#/$defs/TopicBlock"
                },
                {
                  "$ref": "#/$defs/DiscussionBlock"
                },
                {
                  "$ref": "#/$defs/JsonBlock"
                },
                {
                  "$ref": "#/$defs/ImageBlock"
                }
              ]
            },
            "minItems": 1,
            "title": "Blocks",
            "type": "array"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "layout",
          "blocks"
        ],
        "title": "Page",
        "type": "object"
      },
      "PageEvent": {
        "additionalProperties": false,
        "description": "选择当前包内页面。",
        "properties": {
          "kind": {
            "const": "page",
            "title": "Kind",
            "type": "string"
          },
          "pageId": {
            "minLength": 1,
            "title": "Pageid",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "pageId"
        ],
        "title": "PageEvent",
        "type": "object"
      },
      "ProjectBinding": {
        "additionalProperties": false,
        "description": "当前项目摘要。",
        "properties": {
          "kind": {
            "const": "business",
            "title": "Kind",
            "type": "string"
          },
          "resource": {
            "const": "project",
            "title": "Resource",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "resource"
        ],
        "title": "ProjectBinding",
        "type": "object"
      },
      "RecordsBinding": {
        "additionalProperties": false,
        "description": "固定业务集合及可读选择范围。",
        "properties": {
          "kind": {
            "const": "business",
            "title": "Kind",
            "type": "string"
          },
          "resource": {
            "enum": [
              "topics",
              "decisions",
              "workTasks"
            ],
            "title": "Resource",
            "type": "string"
          },
          "scope": {
            "enum": [
              "project",
              "selectedTopic"
            ],
            "title": "Scope",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "resource",
          "scope"
        ],
        "title": "RecordsBinding",
        "type": "object"
      },
      "RecordsBlock": {
        "additionalProperties": false,
        "description": "同类型业务对象集合的受控表现。",
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "region": {
            "enum": [
              "summary",
              "main",
              "aside"
            ],
            "title": "Region",
            "type": "string"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/$defs/PageEvent"
              },
              {
                "type": "null"
              }

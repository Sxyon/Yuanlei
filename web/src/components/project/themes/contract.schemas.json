        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "region": {
            "enum": [
              "summary",
              "main",
              "aside"
            ],
            "title": "Region",
            "type": "string"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/$defs/PageEvent"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "type": {
            "const": "summary",
            "title": "Type",
            "type": "string"
          },
          "binding": {
            "$ref": "#/$defs/ProjectBinding"
          },
          "variant": {
            "enum": [
              "counts",
              "description"
            ],
            "title": "Variant",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "region",
          "type",
          "binding",
          "variant"
        ],
        "title": "SummaryBlock",
        "type": "object"
      },
      "Theme": {
        "additionalProperties": false,
        "description": "独立主题定义，显示名不改议题类型。",
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "title": "Version",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "topicLabel": {
            "minLength": 1,
            "title": "Topiclabel",
            "type": "string"
          },
          "pages": {
            "items": {
              "$ref": "#/$defs/Page"
            },
            "minItems": 1,
            "title": "Pages",
            "type": "array"
          }
        },
        "required": [
          "id",
          "version",
          "name",
          "topicLabel",
          "pages"
        ],
        "title": "Theme",
        "type": "object"
      },
      "TopicBinding": {
        "additionalProperties": false,
        "description": "当前选定议题。",
        "properties": {
          "kind": {
            "const": "business",
            "title": "Kind",
            "type": "string"
          },
          "resource": {
            "const": "selectedTopic",
            "title": "Resource",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "resource"
        ],
        "title": "TopicBinding",
        "type": "object"
      },
      "TopicBlock": {
        "additionalProperties": false,
        "description": "选定议题的问题和预期产出。",
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "region": {
            "enum": [
              "summary",
              "main",
              "aside"
            ],
            "title": "Region",
            "type": "string"
          },
          "action": {
            "anyOf": [
              {
                "$ref": "#/$defs/PageEvent"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "type": {
            "const": "topic",
            "title": "Type",
            "type": "string"
          },
          "binding": {
            "$ref": "#/$defs/TopicBinding"
          }
        },
        "required": [
          "id",
          "title",
          "region",
          "type",
          "binding"
        ],
        "title": "TopicBlock",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "已解析包的定义契约，ZIP边界由后继parser拥有。",
    "properties": {
      "manifest": {
        "$ref": "#/$defs/Manifest"
      },
      "theme": {
        "$ref": "#/$defs/Theme"
      }
    },
    "required": [
      "manifest",
      "theme"
    ],
    "title": "ThemePackage",
    "type": "object"
  },

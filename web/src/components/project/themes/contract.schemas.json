            "default": null
          },
          "type": {
            "const": "records",
            "title": "Type",
            "type": "string"
          },
          "binding": {
            "$ref": "#/$defs/RecordsBinding"
          },
          "variant": {
            "enum": [
              "list",
              "table",
              "selector",
              "compactSelector",
              "conclusions",
              "attention",
              "history"
            ],
            "title": "Variant",
            "type": "string"
          },
          "statuses": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "title": "Statuses",
            "type": "array"
          }
        },
        "required": [
          "id",
          "title",
          "region",
          "type",
          "binding",
          "variant"
        ],
        "title": "RecordsBlock",
        "type": "object"
      },
      "ResourceBinding": {
        "additionalProperties": false,
        "description": "声明的文件或包内资源alias。",
        "properties": {
          "kind": {
            "enum": [
              "file",
              "asset"

{
  "type": "object",
  "properties": {
    "projection_version": {
      "const": "collaboration.read/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "work_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "question": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "node_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "id",
            "revision",
            "node_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "handler": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "user",
                "agent",
                "service"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "type",
            "ref",
            "display_name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "answer_recipient": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "user",
                "agent",
                "service"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "type",
            "ref",
            "display_name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "waiting_executor": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "user",
                "agent",
                "service"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "type",
            "ref",
            "display_name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "human_obligation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "user_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "kind": {
              "enum": [
                "answer",
                "authorize-draft",
                "review-result",
                "verify-delivery"
              ]
            },
            "node_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },

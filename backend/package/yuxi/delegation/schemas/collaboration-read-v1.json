      "required": [
        "id",
        "operation_id",
        "state",
        "predecessor_id",
        "successor_id"
      ],
      "additionalProperties": false
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "attempt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "state": {
              "enum": [
                "pending",
                "accepted",
                "rejected",
                "superseded"
              ]
            }
          },
          "required": [
            "id",
            "attempt_id",
            "state"
          ],
          "additionalProperties": false
        },

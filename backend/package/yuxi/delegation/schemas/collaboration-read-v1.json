                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "user_ref",
            "kind",
            "node_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "answer": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },

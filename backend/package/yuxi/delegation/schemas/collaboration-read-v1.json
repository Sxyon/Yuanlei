      },
      "required": [
        "id",
        "delivery",
        "adoption"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "enum": [
            "unknown",
            "pending",
            "running",
            "terminal-blocked",
            "completed",
            "failed",
            "cancelled",
            "superseded"
          ]
        },
        "predecessor_id": {
          "anyOf": [

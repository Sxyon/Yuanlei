  "required": [
    "projection_version",
    "project_id",
    "work_id",
    "question",
    "handler",
    "answer_recipient",
    "waiting_executor",
    "human_obligation",
    "answer",
    "attempt",
    "result",
    "blocker",
    "execution_recovery",
    "supplement_count",
    "allowed_actions",
    "as_of",
    "completeness"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yuanlei.collaboration.read/1"
}

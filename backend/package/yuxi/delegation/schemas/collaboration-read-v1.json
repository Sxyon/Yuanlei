        "open",
        "resolved",
        "withdrawn",
        "stale"
      ]
    },
    "execution_recovery": {
      "enum": [
        "unknown",
        "none",
        "pending",
        "running",
        "failed",
        "completed"
      ]
    },
    "supplement_count": {
      "type": "integer",
      "minimum": 0
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "open-collaboration-question",
              "open-collaboration-attempt",
              "open-work-result"
            ]
          },
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "work_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "question_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "question_revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "node_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "attempt_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "result_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "project_id",
          "work_id",
          "question_id",
          "question_revision",
          "node_id",
          "attempt_id",
          "result_id"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "open-collaboration-question"
                }
              }
            },
            "then": {
              "properties": {
                "question_id": {
                  "not": {
                    "type": "null"
                  }
                },
                "question_revision": {
                  "not": {
                    "type": "null"
                  }
                },
                "node_id": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "open-collaboration-attempt"
                }
              }
            },
            "then": {
              "properties": {
                "attempt_id": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "open-work-result"
                }
              }
            },
            "then": {
              "properties": {
                "result_id": {
                  "not": {
                    "type": "null"
                  }
                },
                "attempt_id": {
                  "not": {
                    "type": "null"
                  }
                }
              }
            }
          }
        ]
      },
      "maxItems": 8
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "synthetic-design-only"
      ]
    }

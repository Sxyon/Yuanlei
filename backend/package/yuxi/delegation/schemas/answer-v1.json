{
  "type": "object",
  "properties": {
    "protocol": {
      "const": "yuanlei.collaboration/1.0"
    },
    "kind": {
      "const": "answer"
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "question_revision": {
      "type": "integer",
      "minimum": 1
    },
    "answer_id": {
      "type": "string",
      "minLength": 1
    },
    "from_node": {
      "type": "string",
      "minLength": 1
    },
    "to_node": {
      "type": "string",
      "minLength": 1
    },
    "wait_attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "applicability": {
      "type": "object",
      "properties": {
        "criteria_revision": {
          "type": "integer",
          "minimum": 1
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "revision"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 16
        }
      },
      "required": [
        "criteria_revision",
        "decision_refs"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "input_delta": {
      "type": "object"
    },
    "requires_explicit_adoption": {
      "const": true
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object",
      "maxProperties": 4,
      "patternProperties": {
        "^[a-z][a-z0-9_-]{0,31}$": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "protocol",
    "kind",
    "question_id",
    "question_revision",
    "answer_id",
    "from_node",
    "to_node",
    "wait_attempt_id",
    "applicability",
    "body",
    "input_delta",
    "requires_explicit_adoption",
    "action_id"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
